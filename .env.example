# Copy to .env.local for local dev; add the same variables in Vercel → Settings → Environment Variables.
# Never commit real values.

# From https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form messages are delivered (server-side only, never shown on the site).
# Without a verified domain in Resend, this must be the email address you signed up to Resend with.
CONTACT_TO_EMAIL=

# Optional. Defaults to Resend's test sender. Set this after verifying your own domain in Resend.
# CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>
